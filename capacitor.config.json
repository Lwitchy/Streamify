{
  "appId": "com.streamify.music",
  "appName": "Streamify",
  "webDir": "mobile",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "ios": {
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "preferredContentMode": "mobile",
    "handleApplicationURL": true
  }
}
