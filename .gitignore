# --- PROJECT SPECIFIC SETTINGS ---

# 0. Local runtime config (contains machine-specific absolute paths).
#    Seeded automatically from Server/config.example.json on first run.
Server/config.json

# 1. SSL Security
SSL/*
!SSL/.gitkeep

# 2. Database Data
Database/Dev/Music/*
!Database/Dev/Music/.gitkeep

Database/Dev/Users/*
!Database/Dev/Users/.gitkeep

Database/Backups/*
!Database/Backups/.gitkeep

# 3. Static Content
Static/avatars/*
!Static/avatars/.gitkeep

Static/covers/*
!Static/covers/.gitkeep

Static/banners/*
!Static/banners/.gitkeep

# 4. Music Library 
MusicLibrary/*
!MusicLibrary/.gitkeep
!MusicLibrary/uploads/
MusicLibrary/uploads/*
!MusicLibrary/uploads/.gitkeep

# Catch-all
node_modules/
*.part
*.db
*.sqlite3
*.tmp
*.temp
.DS_Store
Thumbs.db
.env.local
.env.*.local

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# --- DESKTOP APP (Electron) ---
# Build output and native rebuild artifacts
dist-electron/
release/
*.nsis.7z

# NOTE: `build/` is deliberately NOT ignored. It holds the application icon that
# electron-builder needs at package time. The Python-era `build/` rule that used
# to live in the section below was removed for this reason.

