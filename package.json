{
  "name": "streamify",
  "version": "0.3.0",
  "description": "Self-hosted music streaming server, desktop app and installable PWA.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node Server/server.js",
    "server": "node Server/server.js",
    "desktop": "electron .",
    "gen-cert": "node Scripts/generate-cert.js",
    "fetch-fpcalc": "node Scripts/fetch-fpcalc.js",
    "test:metadata": "node --test Tests/metadataMatching.test.js Tests/metadataProviders.test.js Tests/metadataEngine.test.js Tests/fingerprint.test.js",
    "rebuild": "electron-builder install-app-deps",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:dir": "electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bad-words": "^3.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "slsk-client": "^1.1.0",
    "socket.io": "^4.8.3",
    "spotify-url-info": "^3.3.0",
    "sqlite3": "^6.0.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
