{
  "name": "streamify",
  "version": "0.4.0",
  "description": "Self-hosted music streaming server, desktop app and installable PWA.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node Server/server.js",
    "server": "node Server/server.js",
    "desktop": "electron .",
    "gen-cert": "node Scripts/generate-cert.js",
    "fetch-fpcalc": "node Scripts/fetch-fpcalc.js",
    "cap:sync": "npx cap sync ios",
    "cap:copy": "npx cap copy ios",
    "mobile:sync": "node Scripts/sync-mobile.js && npx cap sync ios",
    "test:metadata": "node --test Tests/metadataMatching.test.js Tests/metadataProviders.test.js Tests/metadataEngine.test.js Tests/fingerprint.test.js Tests/enrichmentSummary.test.js",
    "test:wiring": "node Tests/domWiring.check.js",
    "test:theme": "node --test Tests/theme.test.js",
    "test:discord": "node --test Tests/discordPresence.test.js Tests/discordArtwork.test.js",
    "test:updater": "node --test Tests/updater.test.js",
    "test:downloads-ui": "node --test Tests/downloadSources.test.js && node Tests/downloadsUi.check.js",
    "test:downloads": "node Tests/downloadEngine.manual.js",
    "test:downloads-security": "node Tests/downloadSecurity.manual.js",
    "rebuild": "electron-builder install-app-deps",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:dir": "electron-builder --win --dir --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:linux:appimage": "electron-builder --linux AppImage --publish never",
    "build:linux:deb": "electron-builder --linux deb --publish never",
    "build:linux:targz": "electron-builder --linux tar.gz --publish never",
    "build:linux:dir": "electron-builder --linux --dir --publish never",
    "release": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux AppImage --publish always"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bad-words": "^3.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "slsk-client": "^1.1.0",
    "socket.io": "^4.8.3",
    "spotify-url-info": "^3.3.0",
    "sqlite3": "^6.0.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
